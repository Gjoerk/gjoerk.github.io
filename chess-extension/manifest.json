{
  "manifest_version": 3,
  "name": "Analyze on gabrielschwarz.com",
  "version": "1.0.0",
  "description": "One click on a chess.com game sends its PGN to the analyzer at gabrielschwarz.com/chess.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Analyze this chess.com game",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Analyze the open chess.com game"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://api.chess.com/*"]
}
